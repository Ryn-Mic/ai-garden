  "edges": [
    {
      "from": "download",
      "to": "choose"
    },
    {
      "from": "choose",
      "to": "provide"
    },
    {
      "from": "provide",
      "to": "execute"
    },
    {
      "from": "execute",
      "to": "check"
    },
    {
      "from": "check",
      "to": "record"
    }
  ],
  "cards": [
    {
      "dot": "amber",
      "title": "边界与验收",
      "items": [
        "练习包的验收清单是人工标准，不是某个客户端的实测输出",
        "答对编号只能作辅助证据；多次通过也不代表所有任务与版本可靠"
      ]
    }
