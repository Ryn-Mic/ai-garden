      "lane": "stage0",
      "col": 2
    },
    {
      "id": "ability",
      "type": "security",
      "label": "检查能力权限",
      "sublabel": "当前模式、工具与审批",
      "width": 180,
      "lane": "stage1",
      "col": 2
    },
    {
      "id": "rules",
      "type": "security",
      "label": "检查说明加载",
      "sublabel": "安装、发现与本轮加载",
