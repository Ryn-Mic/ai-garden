  "edges": [
    {
      "from": "record",
      "to": "task"
    },
    {
      "from": "task",
      "to": "material"
    },
    {
      "from": "material",
      "to": "ability"
    },
    {
      "from": "ability",
      "to": "rules"
    },
    {
      "from": "rules",
      "to": "result"
    }
  ],
  "cards": [
    {
      "dot": "amber",
      "title": "边界与验收",
      "items": [
        "一次只改变一个条件，不同时换模型、装插件、改规则",
        "涉及发送、覆盖或删除时先停止扩大操作，检查真实状态后再决定是否重试"
      ]
