      "lane": "stage1",
      "col": 3
    },
    {
      "id": "result",
      "type": "security",
      "label": "检查实际交付",
      "sublabel": "打开文件或核对业务动作",
      "width": 180,
      "lane": "stage1",
      "col": 4
    }
