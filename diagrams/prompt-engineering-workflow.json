{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "Prompt 工程最佳实践",
    "locale": "zh-CN",
    "quality_profile": "showcase"
  },
  "lanes": [
    { "id": "basic", "label": "基础流程" },
    { "id": "advanced", "label": "进阶技巧", "variant": "exception" }
  ],
  "mainPath": ["define", "context", "format", "test", "evaluate"],
  "nodes": [
    { "id": "define", "lane": "basic", "col": 0, "type": "external", "label": "明确任务", "sublabel": "清晰目标", "width": 130 },
    { "id": "context", "lane": "basic", "col": 1, "type": "backend", "label": "提供上下文", "sublabel": "背景与约束", "width": 130 },
    { "id": "format", "lane": "basic", "col": 2, "type": "backend", "label": "指定格式", "sublabel": "输出结构", "width": 130 },
    { "id": "test", "lane": "basic", "col": 3, "type": "cloud", "label": "测试输出", "sublabel": "运行验证", "width": 130 },
    { "id": "evaluate", "lane": "basic", "col": 4, "type": "backend", "label": "评估结果", "sublabel": "质量检查", "width": 130 },

    { "id": "cot", "lane": "advanced", "col": 2, "type": "messagebus", "label": "思维链", "sublabel": "CoT 推理", "tag": "复杂任务", "width": 130 },
    { "id": "role", "lane": "advanced", "col": 3, "type": "messagebus", "label": "角色扮演", "sublabel": "专家视角", "width": 130 }
