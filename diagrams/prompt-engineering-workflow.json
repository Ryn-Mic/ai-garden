  "edges": [
    { "from": "define", "to": "context", "label": "定义目标", "variant": "emphasis" },
    { "from": "context", "to": "format", "label": "添加约束", "variant": "emphasis" },
    { "from": "format", "to": "test", "label": "生成 Prompt", "variant": "emphasis" },
    { "from": "test", "to": "evaluate", "label": "检查输出", "variant": "emphasis" },
    { "from": "evaluate", "to": "context", "label": "迭代优化", "variant": "dashed", "role": "branch" },

    { "from": "format", "to": "cot", "label": "需要推理", "variant": "dashed", "role": "branch" },
    { "from": "cot", "to": "role", "label": "设定角色", "variant": "dashed" },
    { "from": "role", "to": "test", "label": "应用技巧", "variant": "dashed" }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "基础要素",
      "items": [
        "清晰的任务描述和期望输出",
        "必要的背景信息和约束条件",
        "明确的输出格式要求（JSON/Markdown/文本）"
      ]
    },
    {
      "dot": "amber",
      "title": "进阶技巧",
      "items": [
        "思维链（CoT）：让模型展示推理过程",
        "角色扮演：分配专家角色提升质量",
        "Few-shot：提供示例引导输出格式"
      ]
    },
    {
      "dot": "emerald",
      "title": "评估标准",
      "items": [
        "准确性：回答是否正确和相关",
        "一致性：多次运行结果是否稳定",
        "格式：是否符合指定的输出结构"
      ]
    }
  ]
